MONGO_URI=
PORT=5000
JWT_TOKEN_SECRET=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GMAIL_USER=your_gmail_address

# --- Smart Hospital Queue (QR check-in) ---
# Secret used to derive patient QR tokens. Use a long random string (e.g. `openssl rand -hex 32`).
# If omitted, JWT_TOKEN_SECRET is used. Changing it invalidates all issued QR codes.
QR_TOKEN_SECRET=replace_with_a_long_random_secret
# Minutes after the scheduled END time when attended appointments auto-complete
# (and unattended confirmed ones become No-Show). Default 60.
APPOINTMENT_COMPLETION_GRACE_MINUTES=60
